{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowRunInstances",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "*"
    },
    {
      "Sid": "DenyRunInstancesForOtherProjects",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestTag/project": "deepcuts"
        }
      }
    }
  ]
}
